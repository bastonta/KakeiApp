<?xml version="1.0" encoding="utf-8"?>
<!--
   Kakei stores an encrypted ledger plus the Keystore-wrapped database key and
   session tokens. None of it is portable to another device (the Keystore key
   never leaves the hardware), so every local data domain is excluded from
   Auto Backup. android:allowBackup is also disabled in the manifest.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
