<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+ backup / device-transfer rules. The encrypted database, the wrapped
   SQLCipher key and the session tokens must never leave the device, so all
   local data is excluded from cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
